<?xml version="1.0" encoding="UTF-8"?>
<!-- Silo Skyline: Live TV keys as TiviMate's. Copy to userdata/keymaps/ (named to
     load after other keymaps, which it overrides only for these keys):
       OK         the recently watched channels (Skyline's window 1196)
       Long OK    the TV guide (Sky has it and the banner, which Left/Right/Up/Down
                  drive); on the OK screen, its channel's menu (Remove from recent
                  channels). It sets silo.live.longok; Skyline's timer decides, as
                  this section also catches the key in the OK screen
       Up / Down  the channel above or below, as in the guide (lower and higher
                  numbers). Kodi's Down / Up actions: with Kodi's "Confirm channel
                  switch" on (its default) they browse channels in the banner and OK
                  watches the one shown, as Sky's mini guide; off, they switch at once
       Left/Right the programme before (catch-up) or after on the channel the
                  banner shows, browsed or playing, as Sky's banner (they set
                  silo.live.step; Skyline's timers open the banner and step); OK plays
                  an earlier one or sets a later one's reminder. The channel
                  watched before is first in OK's recent channels. -->
<keymap>
  <FullscreenLiveTV>
    <keyboard>
      <return>ActivateWindow(1196)</return>
      <enter>ActivateWindow(1196)</enter>
      <return mod="longpress">SetProperty(silo.live.longok,1,home)</return>
      <enter mod="longpress">SetProperty(silo.live.longok,1,home)</enter>
      <up>Down</up>
      <down>Up</down>
      <left>SetProperty(silo.live.step,-1,home)</left>
      <right>SetProperty(silo.live.step,1,home)</right>
    </keyboard>
    <remote>
      <select>ActivateWindow(1196)</select>
      <select mod="longpress">SetProperty(silo.live.longok,1,home)</select>
      <up>Down</up>
      <down>Up</down>
      <left>SetProperty(silo.live.step,-1,home)</left>
      <right>SetProperty(silo.live.step,1,home)</right>
    </remote>
  </FullscreenLiveTV>
</keymap>
