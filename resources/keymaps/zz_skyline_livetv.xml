<?xml version="1.0" encoding="UTF-8"?>
<!-- Silo Skyline: Live TV keys as TiviMate's. Copy to userdata/keymaps/ (named to
     load after other keymaps, which it overrides only for these keys):
       OK         the recently watched channels (Skyline's window 1196)
       Long OK    the mini guide, as Sky's (Skyline's window 1198)
       Up / Down  the channel above or below, as in the guide (lower and higher
                  numbers). Kodi's Down / Up actions: with Kodi's "Confirm channel
                  switch" on (its default) they browse channels in the banner and OK
                  watches the one shown, as Sky's mini guide; off, they switch at once
       Left       the quick guide (Kodi's channel list over the video)
       Right      the channel watched before this one (KodiConnectForSilo) -->
<keymap>
  <FullscreenLiveTV>
    <keyboard>
      <return>ActivateWindow(1196)</return>
      <enter>ActivateWindow(1196)</enter>
      <return mod="longpress">ActivateWindow(1198)</return>
      <enter mod="longpress">ActivateWindow(1198)</enter>
      <up>Down</up>
      <down>Up</down>
      <left>ActivateWindow(PVROSDChannels)</left>
      <right>RunPlugin(plugin://plugin.video.kodiconnectforsilo/?mode=previous_channel)</right>
    </keyboard>
    <remote>
      <select>ActivateWindow(1196)</select>
      <select mod="longpress">ActivateWindow(1198)</select>
      <up>Down</up>
      <down>Up</down>
      <left>ActivateWindow(PVROSDChannels)</left>
      <right>RunPlugin(plugin://plugin.video.kodiconnectforsilo/?mode=previous_channel)</right>
    </remote>
  </FullscreenLiveTV>
</keymap>
